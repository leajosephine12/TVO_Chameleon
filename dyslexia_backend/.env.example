# Copy this file to ".env" in the dyslexia_backend folder and edit it. ".env" is git-ignored: never commit real keys.
# scripts/smoke_test.py reads ".env" automatically. A value set in the terminal wins over this file.

# Use the built-in mock instead of a model (1 = mock, leave empty or remove for a real model)
MODEL_MOCK=1

# Real model (Ollama on this computer). Only used when MODEL_MOCK is not 1.
MODEL_BASE_URL=http://localhost:11434/v1
# Must match a name shown by `ollama list`. This tag exists on ollama.com but is not verified on your machine.
MODEL_NAME=gemma4:e4b-it-qat

# Only for a hosted model (for example RunPod). Ollama does not need it. Leave empty otherwise.
MODEL_API_KEY=

# Optional tuning
# MODEL_TIMEOUT=120      seconds to wait for one model reply
# MODEL_MAX_RETRIES=2    retries after an invalid reply (so up to 3 calls)
# MODEL_REASONING_EFFORT=none   REQUIRED in practice for Gemma 4 on Ollama: it is a "thinking" model and otherwise
#                               spends minutes reasoning before it answers (measured: 9+ minutes per call on a CPU laptop)
